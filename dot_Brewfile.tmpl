# Installed by chezmoi with `brew bundle --global`. Edit here, then `chezmoi apply`.

# Shell and everyday CLIs
brew "chezmoi"
brew "atuin"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "neovim"
brew "bat"
brew "fzf"
brew "ripgrep"
brew "jq"
brew "fx"
brew "csvlens"
brew "gh"

# Toolchains (versions are installed by the toolchains script)
brew "fnm"
brew "uv"
tap "oven-sh/bun"
brew "oven-sh/bun/bun"

# CLIs and fonts shipped as casks
cask "1password-cli"
cask "claude-code"
cask "font-fira-code"

{{- if eq .machine "work" }}

# Work: Teachiq / Exam.net
cask "azure-cli"
brew "swiftlint"
brew "swiftformat"
cask "gcloud-cli"

{{- end }}
{{- if eq .machine "personal" }}

# Personal
brew "flyctl"
brew "caddy"
brew "nmap"
cask "discord"
cask "spotify"
cask "steam"
cask "vlc"
cask "kdenlive"
cask "vuescan"
cask "raspberry-pi-imager"
cask "balenaetcher"
cask "openscad"

{{- end }}
